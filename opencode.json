{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "write": {
      "AGENTS.md": "deny",
      "product/**": "deny",
      ".agent/**": "deny",
      "*": "allow"
    },
    "bash": {
      "git commit*": "deny",
      "git push*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git amend*": "deny",
      "*": "allow"
    },
    "web": "deny",
    "task": "deny",
    "subagent": "deny"
  },
  "share": "disabled",
  "autoupdate": false
}